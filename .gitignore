.zig-cache/
zig-out/
# Fetched dependency sources (the unpacked upstream OpenSSL tree). Build
# output, never vendored: build.zig.zon's content hash is the record of
# what we build against.
/zig-pkg/

# direnv / devenv working state (.envrc, devenv.nix, devenv.yaml and
# devenv.lock are tracked; what they generate is not).
.direnv/
.devenv*
devenv.local.nix
